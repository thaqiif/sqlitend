# sqlitend environment configuration.
# All values are optional; these are the defaults. Invalid values fail loudly
# at startup.

# Control-plane API + web UI listener port. Default 6100.
SQLITEND_PORT=6100

# Bind address: 0.0.0.0 = all interfaces (public — the default), 127.0.0.1 = localhost only.
SQLITEND_HOST=0.0.0.0

# Host advertised in database connection URLs (http/hrana/grpc) — the address
# remote clients should dial. Default: 127.0.0.1, or SQLITEND_HOST when it is
# an explicit address. On a public server set it to the machine's address, e.g.
# SQLITEND_PUBLIC_HOST=100.97.250.76 or a DNS name.
SQLITEND_PUBLIC_HOST=127.0.0.1

# Port range used for the http+grpc port PAIR allocated to each database. Default 6101-6300.
SQLITEND_PORT_RANGE=6101-6300

# Root directory holding metadata.sqlite, per-database signing keys (keys/),
# and all database data dirs (workspaces/<ws>/dbs/<slug>). Default ~/.local/share/sqlitend.
SQLITEND_DATA_ROOT=

# Path to the pinned sqld binary. Default <repo>/bin/sqld.
SQLITEND_SQLD_PATH=

# Default token lifetime in hours when creating a DB access token (1-8760). Default 24.
SQLITEND_TOKEN_TTL_HOURS=24

# Metrics sampler + UI poll interval in MILLISECONDS (250-600000). Default 5000.
SQLITEND_SAMPLE_INTERVAL_MS=5000

# sqld launch ready probe timeout in MILLISECONDS (500-120000). Default 10000.
SQLITEND_READY_TIMEOUT_MS=10000

# Max accepted JSON body size for mutating API calls, bytes. Default 1000000.
SQLITEND_MAX_BODY_BYTES=1000000

# --- Gateway: one public HTTPS hostname per database ------------------------
# Port for the host-routed gateway. 0 (default) disables it.
SQLITEND_GATEWAY_PORT=0
# Bind address for the gateway. Keep loopback and front it with Cloudflare
# Tunnel / a TLS reverse proxy (see docs/gateway.md).
SQLITEND_GATEWAY_HOST=127.0.0.1
# Public hostname per database; {db} is replaced by the database slug or id and
# must sit in the first DNS label, e.g. {db}-libsql.cloudsby.me.
SQLITEND_GATEWAY_HOST_TEMPLATE=
# Max proxied request body, bytes. Default 33554432 (32 MiB).
SQLITEND_GATEWAY_MAX_BODY_BYTES=33554432

# --- Cloudflare DNS automation (optional; requires the gateway) --------------
# Creates/removes a proxied CNAME <db>-libsql.<zone> -> <tunnel>.cfargotunnel.com
# per database. API token scope: Zone -> DNS -> Edit, on this zone only.
SQLITEND_CF_API_TOKEN=
SQLITEND_CF_ZONE_ID=
SQLITEND_CF_TUNNEL_ID=

# --- Control-plane login ------------------------------------------------------
# on (default) | off. off is refused unless SQLITEND_HOST is loopback (dev only).
# Set the password with: sqlitend set-password
SQLITEND_AUTH=on
# Client IP source when a local proxy/tunnel fronts the control plane
# (off | cloudflare | xff). Forwarded headers are honoured only from loopback peers.
SQLITEND_TRUST_PROXY=off
# Session cookie Secure flag: auto (HTTPS requests) | on (always — use behind TLS).
SQLITEND_COOKIE_SECURE=auto
